# Production Environment Variables for Vercel
# IMPORTANT: These need to be configured in Vercel dashboard

# Option 1: Backend on custom domain (with /api/v1 path)
# VITE_API_URL=https://api.webshield.tech

# Option 2: Backend on Vercel with reverse proxy
# VITE_API_URL=https://www.webshield.tech

# Option 3: Backend on AWS EC2 (direct IP)
# VITE_API_URL=https://YOUR_EC2_PUBLIC_IP:4000

# Current production note:
# Make sure VITE_API_URL is configured in Vercel Project Settings > Environment Variables
# The frontend will fail to login if this is not set correctly

# For local development, use .env.local with:
# VITE_API_URL=http://localhost:4000
